{
  "mcpServers": {
    "angular-cli": {
      "command": "npx",
      "args": [
        "-y",
        "@angular/cli",
        "mcp"
      ]
    },
    "decktech": {
      "command": "node",
      "args": [
        "dist-mcp/decktech-mcp.mjs"
      ],
      "env": {
        "DECKTECH_WORKSPACE": "decks"
      }
    }
  }
}
