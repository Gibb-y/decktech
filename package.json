{
  "name": "decktech",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "lint:boundaries": "node scripts/check-boundaries.mjs",
    "lint:tokens": "node scripts/check-tokens.mjs",
    "test:scripts": "node --test scripts/",
    "build:mcp": "esbuild mcp/main.ts --bundle --platform=node --format=esm --target=node20 --loader:.md=text --external:playwright --outfile=dist-mcp/decktech-mcp.mjs --banner:js=\"#!/usr/bin/env node\"",
    "test:mcp": "vitest run --config mcp/vitest.config.mts",
    "typecheck:mcp": "tsc --noEmit -p mcp/tsconfig.json"
  },
  "private": true,
  "packageManager": "npm@11.19.1",
  "dependencies": {
    "@angular/common": "^22.2.0",
    "@angular/compiler": "^22.2.0",
    "@angular/core": "^22.2.0",
    "@angular/forms": "^22.2.0",
    "@angular/platform-browser": "^22.2.0",
    "@angular/router": "^22.2.0",
    "@codemirror/autocomplete": "^6.20.4",
    "@codemirror/commands": "^6.11.1",
    "@codemirror/lang-css": "^6.3.1",
    "@codemirror/lang-html": "^6.4.12",
    "@codemirror/lang-javascript": "^6.2.5",
    "@codemirror/language": "^6.13.1",
    "@codemirror/search": "^6.7.2",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.15",
    "fflate": "^0.8.3",
    "idb": "^8.0.4",
    "prosemirror-commands": "^1.7.2",
    "prosemirror-history": "^1.5.1",
    "prosemirror-keymap": "^1.2.3",
    "prosemirror-model": "^1.25.12",
    "prosemirror-schema-list": "^1.5.1",
    "prosemirror-state": "^1.4.4",
    "prosemirror-transform": "^1.12.2",
    "prosemirror-view": "^1.42.6",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular/build": "^22.3.0-next.3",
    "@angular/cli": "^22.2.3",
    "@angular/compiler-cli": "^22.2.0",
    "@modelcontextprotocol/server": "^2.3.1",
    "@types/node": "^22.20.5",
    "acorn": "^8.19.0",
    "axe-core": "^4.14.0",
    "fake-indexeddb": "^6.2.6",
    "jsdom": "^30.0.0",
    "playwright": "^1.64.1",
    "prettier": "^3.8.1",
    "typescript": "~6.0.2",
    "vitest": "^5.0.0",
    "zod": "^4.6.6"
  }
}
